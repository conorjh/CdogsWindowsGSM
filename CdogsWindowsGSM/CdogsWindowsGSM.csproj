<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows10.0.19041</TargetFramework>
	<UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<EnableWindowsTargeting>true</EnableWindowsTargeting>
	<RootNamespace>WindowsGSM</RootNamespace>
	<AssemblyName>CdogsWindowsGSM</AssemblyName>
	<Version>2.0.0-preview.1</Version>
	<AssemblyVersion>2.0.0.0</AssemblyVersion>
	<FileVersion>2.0.0.0</FileVersion>
	<InformationalVersion>2.0.0-preview.1</InformationalVersion>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	<StartupObject>WindowsGSM.Program</StartupObject>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>Images\WindowsGSM.ico</ApplicationIcon>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<ImplicitUsings>disable</ImplicitUsings>
	<Nullable>disable</Nullable>
	<LangVersion>latest</LangVersion>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<PublishSingleFile>true</PublishSingleFile>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	<DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
	<Resource Include="Images\**\*.*" />
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="Discord.Net.WebSocket" Version="3.20.2" />
	<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
	<PackageReference Include="MahApps.Metro" Version="2.4.11" />
	<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
	<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
	<PackageReference Include="NCrontab.Signed" Version="3.4.0" />
	<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	<PackageReference Include="SharpCompress" Version="0.50.7" />
	<PackageReference Include="SharpZipLib" Version="1.4.2" />
	<PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>
</Project>
