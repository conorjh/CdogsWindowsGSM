                          SelectionChanged="DataGrid_SelectionChanged"
                          LoadingRow="ServerGrid_LoadingRow"
                          PreviewMouseRightButtonDown="ServerGrid_PreviewMouseRightButtonDown"
                          IsSynchronizedWithCurrentItem="True"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Resources>
                        <ContextMenu x:Key="ServerRowContextMenu">
                            <MenuItem Header="{loc:Loc Key=ActionsMenu}">
                                <MenuItem Header="{loc:Loc Key=Start}" Click="Actions_Start_Click"/>
                                <MenuItem Header="{loc:Loc Key=Stop}" Click="Actions_Stop_Click"/>
                                <MenuItem Header="{loc:Loc Key=Restart}" Click="Actions_Restart_Click"/>
                                <MenuItem Header="{loc:Loc Key=ButtonKill}" Click="Actions_Kill_Click"/>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Key=ToggleConsole}" Click="Actions_ToggleConsole_Click"/>
                                <MenuItem Header="{loc:Loc Key=Update}">
                                    <MenuItem Header="{loc:Loc Key=Update}" Click="Actions_Update_Click"/>
                                    <MenuItem Header="{loc:Loc Key=UpdateValidate}" Click="Actions_UpdateValidate_Click"/>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=Backup}" Click="Actions_Backup_Click"/>
                                <MenuItem Header="{loc:Loc Key=RestoreBackup}" Click="Actions_RestoreBackup_Click"/>
                                <MenuItem Header="{loc:Loc Key=ButtonManageAddons}" Click="Actions_ManageAddons_Click"/>
                            </MenuItem>
                            <MenuItem Header="{loc:Loc Key=BrowseMenu}">
                                <MenuItem Header="{loc:Loc Key=ServerBackups}">
                                    <MenuItem Header="{loc:Loc Key=BackupFiles}" Click="Browse_ServerBackups_Click"/>
                                    <MenuItem Header="{loc:Loc Key=BackupConfigs}" Click="Browse_BackupFiles_Click"/>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc Key=ServerFiles}" Click="Browse_ServerFiles_Click"/>
                                <MenuItem Header="{loc:Loc Key=ServerConfigs}" Click="Browse_ServerConfigs_Click"/>
                            </MenuItem>
                            <MenuItem Header="{loc:Loc Key=ToolsMenu}">
                                <MenuItem Header="{loc:Loc Key=GlobalServerListCheck}" Click="Tools_GlobalServerListCheck_Click"/>
                                <MenuItem Header="{loc:Loc Key=InstallAddons}">
                                    <MenuItem Header="{loc:Loc Key=AddonAmxMetamod}" Click="Tool_InstallAMXModXMetamodP_Click"/>
                                    <MenuItem Header="{loc:Loc Key=AddonSourceMetamod}" Click="Tools_InstallSourcemodMetamod_Click"/>
                                    <MenuItem Header="{loc:Loc Key=AddonDayzSal}" Click="Tools_InstallDayZSALModServer_Click"/>
                                    <MenuItem Header="{loc:Loc Key=AddonOxide}" Click="Tools_InstallOxideMod_Click"/>
                                </MenuItem>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Key=DeleteGameServer}" Click="Delete_Click"/>
                        </ContextMenu>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnId}" IsReadOnly="True" Binding="{Binding Path=ID}" SortMemberPath="IDSort" Width="35" MinWidth="35" MaxWidth="35"/>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnPid}" IsReadOnly="True" Binding="{Binding Path=PID}" SortMemberPath="PIDSort" Width="65" MinWidth="55" MaxWidth="95"/>
                        <DataGridTemplateColumn Header="{loc:Loc Key=ColumnMod}" IsReadOnly="True" Width="53" MinWidth="53" MaxWidth="53">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="18" ToolTip="{Binding Game}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnStatus}" IsReadOnly="True" Binding="{Binding Path=Status}" Width="80" MinWidth="80" MaxWidth="80"/>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnServerName}" IsReadOnly="True" Binding="{Binding Path=Name}" Width="10*" MinWidth="105"/>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnIpAddress}" IsReadOnly="True" Binding="{Binding Path=IP}" Width="4*" MinWidth="88"/>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnPort}" IsReadOnly="True" Binding="{Binding Path=Port}" SortMemberPath="PortSort" Width="4*" MinWidth="52"/>
                        <DataGridTemplateColumn Header="{loc:Loc Key=ColumnQueryPort}" IsReadOnly="True" SortMemberPath="QueryPortSort" Width="4*" MinWidth="93">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding Path=QueryPortToolTip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path=QueryPort}"/>
                                            <TextBlock Text="{Binding Path=QueryPortMismatchDisplay}" Foreground="Firebrick" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnMap}" IsReadOnly="True" Binding="{Binding Path=Defaultmap}" Width="7*" MinWidth="50"/>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnPlayers}" IsReadOnly="True" Binding="{Binding Path=Maxplayers}" SortMemberPath="PlayerCapacitySort" Width="3*" MinWidth="70"/>
                        <DataGridTextColumn Header="{loc:Loc Key=ColumnUptime}" IsReadOnly="True" Binding="{Binding Path=Uptime}" Width="4*" MinWidth="80"/>
                        <!--<DataGridTextColumn Header="RAM Usage" IsReadOnly="True" Binding="{Binding Path=RamUsage}" Width="4*"/>-->
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch">
                    <GridSplitter.Background>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlDarkDarkColorKey}}"/>
                    </GridSplitter.Background>
                </GridSplitter>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="475" MaxWidth="475"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Button x:Name="button_Status" Content="" HorizontalAlignment="Left" Margin="399,10,0,0" Width="50" Height="11" Background="Orange" Foreground="White" VerticalAlignment="Top" IsHitTestVisible="False" />

                        <Label x:Name="label_ProcessPriority" Content="{loc:Loc Key=ProcessPriority}" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" Height="26"/>
                        <Slider x:Name="slider_ProcessPriority" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="101,10,0,0" Width="86" Height="25" Style="{StaticResource MahApps.Styles.Slider}" Minimum="0" Maximum="5" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="Slider_ProcessPriority_ValueChanged"/>
                        <TextBox x:Name="textBox_ProcessPriority" Height="11" Margin="192,10,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" IsReadOnly="true" HorizontalAlignment="Left" Width="95" FontFamily="Consolas"/>

                        <Button x:Name="button_SetAffinity" Content="{loc:Loc Key=SetAffinityButton}" HorizontalAlignment="Left" Margin="292,10,0,0" VerticalAlignment="Top" Width="85" Height="26" Click="Button_SetAffinity_Click"/>
                        <TextBox x:Name="textBox_SetAffinity" Height="11" Margin="389,10,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" IsReadOnly="true" HorizontalAlignment="Left" Width="66" FontFamily="Consolas"/>
                        <Button x:Name="button_EditConfig" Content="{loc:Loc Key=EditConfigButton}" HorizontalAlignment="Left" Margin="382,10,0,0" VerticalAlignment="Top" Width="85" Height="26" Click="Button_EditConfig_Click"/>

                        <Label x:Name="label_restartcrontab" Content="{loc:Loc Key=RestartCrontab}" HorizontalAlignment="Left" Margin="5,40,0,0" VerticalAlignment="Top" Height="26"/>
                        <mah:ToggleSwitch x:Name="switch_restartcrontab" Margin="99,38,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_RestartCrontab_Click" Width="44" Height="30"/>
                        <Button x:Name="button_restartcrontabedit" Cursor="Hand" Content="{loc:Loc Key=ButtonEdit}" HorizontalAlignment="Left" Margin="150,40,0,0" VerticalAlignment="Top" Width="37" Height="26" Click="Button_CrontabEdit_Click"/>
                        <TextBox x:Name="textBox_restartcrontab" Height="23" Margin="192,40,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" IsReadOnly="true" HorizontalAlignment="Left" Width="95"/>
                        <TextBox x:Name="textBox_nextcrontab" Height="11" Margin="292,40,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" IsReadOnly="true" HorizontalAlignment="Left" Width="175" FontFamily="Consolas"/>

                        <Label Content="{loc:Loc Key=AutoStart}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Margin="5,127,0,0"/>
                        <mah:ToggleSwitch x:Name="switch_autostart" Margin="100,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_AutoStart_Click" Width="44" Height="30"/>

                        <Label x:Name="label_embedconsole" Content="{loc:Loc Key=EmbedConsole}" HorizontalAlignment="Left" Margin="5,99,0,0" VerticalAlignment="Top"/>
                        <mah:ToggleSwitch x:Name="switch_embedconsole" Margin="100,97,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_EmbedConsole_Click" Width="44" Height="30"/>

                        <Label Content="{loc:Loc Key=AutoRestart}" HorizontalAlignment="Left" Margin="177,127,0,0" VerticalAlignment="Top"/>
                        <mah:ToggleSwitch x:Name="switch_autorestart" Margin="258,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_AutoRestart_Click" Width="44" Height="30"/>

                        <Label Content="{loc:Loc Key=AutoUpdate}" HorizontalAlignment="Left" Margin="338,127,0,0" VerticalAlignment="Top"/>
                        <mah:ToggleSwitch x:Name="switch_autoupdate" Margin="422,125,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_AutoUpdate_Click" Width="44" Height="30"/>

                        <Label Content="{loc:Loc Key=UpdateOnStart}" HorizontalAlignment="Left" Margin="159,99,0,0" VerticalAlignment="Top"/>
                        <mah:ToggleSwitch x:Name="switch_updateonstart" Margin="258,97,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_UpdateOnStart_Click" Width="44" Height="30"/>

                        <Label Content="{loc:Loc Key=BackupOnStart}" HorizontalAlignment="Left" Margin="323,99,0,0" VerticalAlignment="Top"/>
                        <mah:ToggleSwitch x:Name="switch_backuponstart" Margin="422,97,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_BackupOnStart_Click" Width="44" Height="30"/>

                        <Label x:Name="label_discordalert" Content="{loc:Loc Key=DiscordAlert}" HorizontalAlignment="Left" Margin="5,70,0,0" VerticalAlignment="Top"/>
                        <mah:ToggleSwitch x:Name="switch_discordalert" Margin="99,68,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Toggled="Button_DiscordAlert_Click" Width="44" Height="30"/>
                        <Button x:Name="button_discordedit" Cursor="Hand" Content="{loc:Loc Key=ButtonEdit}" HorizontalAlignment="Left" Margin="150,70,0,0" VerticalAlignment="Top" Width="37" Height="26" Click="Button_DiscordEdit_Click"/>
                        <Button x:Name="button_discordset" Cursor="Hand" Content="{loc:Loc Key=SetMessage}" HorizontalAlignment="Left" Margin="192,70,0,0" VerticalAlignment="Top" Width="95" Height="26" Click="Button_DiscordSetMessage_Click"/>
                        <Button x:Name="button_discordtest" Cursor="Hand" Content="{loc:Loc Key=TestAlert}" HorizontalAlignment="Left" Margin="382,70,0,0" VerticalAlignment="Top" Width="85" Height="26" Click="Button_DiscordWebhookTest_Click" IsEnabled="False"/>
                        <Button x:Name="button_discordsettings" Content="{loc:Loc Key=SettingsButton}" HorizontalAlignment="Left" Margin="292,70,0,0" VerticalAlignment="Top" Width="85" Height="26" Click="Button_DiscordAlertSettings_Click"/>
                        <Label x:Name="label_wgsmlog" Content="{loc:Loc Key=Log}" HorizontalAlignment="Left" Margin="24,154,0,0" VerticalAlignment="Top"/>
                        <Button x:Name="button_clearwgsmlog" Cursor="Hand" Content="{loc:Loc Key=Clear}" Margin="10,0,0,10" Height="18" Click="Button_ClearWGSMLog_Click" HorizontalAlignment="Left" Width="45" VerticalAlignment="Bottom"/>
                        <TextBox x:Name="textBox_wgsmlog" Margin="10,157,10,10" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"/>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch">
                        <GridSplitter.Background>
                            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlDarkDarkColorKey}}"/>
                        </GridSplitter.Background>
                    </GridSplitter>

                    <Grid Grid.Column="2" MinWidth="100">
                        <Rectangle Height="30" VerticalAlignment="Top" Fill="Black"/>
                        <Button x:Name="Button_AutoScroll" Style="{DynamicResource MahApps.Styles.Button.Square}" Cursor="Hand" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" Content="{loc:Loc Key=AutoScrollButton}" mah:ControlsHelper.CornerRadius="0" Background="Black" Foreground="White" Height="30" mah:ControlsHelper.ContentCharacterCasing="Upper" BorderThickness="0" Click="Button_AutoScroll_Click" />
                        <Button x:Name="button_clearServerConsole" Style="{DynamicResource MahApps.Styles.Button.Square}" Cursor="Hand" Content="{loc:Loc Key=Clear}" Height="30" Click="Button_ClearServerConsole_Click" HorizontalAlignment="Right" Width="61" mah:ControlsHelper.CornerRadius="0" VerticalAlignment="Top" Background="Black" Foreground="White" mah:ControlsHelper.ContentCharacterCasing="Upper" BorderThickness="0" />
                        <TextBox x:Name="console" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility ="Disabled" Background="Black" IsReadOnly="True" Margin="0,30,0,26" BorderBrush="Black" Foreground="White" BorderThickness="0" SelectionBrush="White" TextWrapping="Wrap"/>
                        <TextBox x:Name="textbox_servercommand" TextWrapping="Wrap" Text="" Margin="0,0,61,0" Height="23" VerticalAlignment="Bottom" KeyDown="Textbox_ServerCommand_KeyDown" IsEnabled="False" Background="Black" BorderBrush="White" Foreground="White" CaretBrush="White" PreviewKeyDown="Textbox_ServerCommand_PreviewKeyDown"/>
                        <Button x:Name="button_servercommand" Cursor="Hand" Content="{loc:Loc Key=Send}" Click="Button_ServerCommand_Click" IsEnabled="False" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="61" mah:ControlsHelper.CornerRadius="0" />
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>

        <Grid>
            <Grid.Resources>
                <DataTemplate x:Key="MenuItemTemplate" DataType="{x:Type mah:HamburgerMenuImageItem}">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" VerticalAlignment="Center" Source="{Binding Thumbnail}" Height="20" Width="20"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="{Binding Label}"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="OptionsMenuItemTemplate" DataType="{x:Type mah:HamburgerMenuImageItem}">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding Thumbnail}" Height="20" Width="20"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="{Binding Label}"/>
                    </Grid>
                </DataTemplate>
            </Grid.Resources>
            <mah:HamburgerMenu x:Name="HamburgerMenuControl"
                                    DisplayMode="CompactInline"
                                    IsPaneOpen="False"
                                    ItemTemplate="{StaticResource MenuItemTemplate}"
                                    OptionsItemTemplate="{StaticResource OptionsMenuItemTemplate}"
                                    ItemClick="HamburgerMenu_ItemClick"
                                    Loaded="HamburgerMenu_Loaded"
                                    MinWidth="49"
                                    Width="2500"
                                    HorizontalAlignment="Left"
                                    Visibility="Hidden"
                                    SelectedIndex="0"
                                    Padding="0" OptionsItemClick="HamburgerMenu_OptionsItemClick">

                <!--  Items  -->
                <mah:HamburgerMenu.ItemsSource>
                    <mah:HamburgerMenuItemCollection>
                        <mah:HamburgerMenuImageItem Label="{loc:Loc Key=NavHome}">
                            <mah:HamburgerMenuImageItem.Thumbnail>
                                <BitmapImage UriSource="pack://application:,,,/CdogsWindowsGSM;component/Images/HMenu/Home.ico" />
                            </mah:HamburgerMenuImageItem.Thumbnail>
                        </mah:HamburgerMenuImageItem>
                        <mah:HamburgerMenuImageItem Label="{loc:Loc Key=NavDashboard}">
                            <mah:HamburgerMenuImageItem.Thumbnail>
                                <BitmapImage UriSource="pack://application:,,,/CdogsWindowsGSM;component/Images/HMenu/Dashboard.ico" />
                            </mah:HamburgerMenuImageItem.Thumbnail>
                        </mah:HamburgerMenuImageItem>
                        <mah:HamburgerMenuImageItem Label="{loc:Loc Key=NavDiscordBot}">
                            <mah:HamburgerMenuImageItem.Thumbnail>
                                <BitmapImage UriSource="pack://application:,,,/CdogsWindowsGSM;component/Images/HMenu/Discord.ico" />
                            </mah:HamburgerMenuImageItem.Thumbnail>
                        </mah:HamburgerMenuImageItem>
                    </mah:HamburgerMenuItemCollection>
                </mah:HamburgerMenu.ItemsSource>

                <mah:HamburgerMenu.OptionsItemsSource>
                    <mah:HamburgerMenuItemCollection>
                        <mah:HamburgerMenuImageItem Label="{loc:Loc Key=NavPlugins}">
                            <mah:HamburgerMenuImageItem.Thumbnail>
                                <BitmapImage UriSource="pack://application:,,,/CdogsWindowsGSM;component/Images/HMenu/ViewPlugins.ico" />
                            </mah:HamburgerMenuImageItem.Thumbnail>
                        </mah:HamburgerMenuImageItem>
                        <mah:HamburgerMenuImageItem Label="{loc:Loc Key=NavSettings}">
                            <mah:HamburgerMenuImageItem.Thumbnail>
                                <BitmapImage UriSource="pack://application:,,,/CdogsWindowsGSM;component/Images/HMenu/Settings.ico" />
                            </mah:HamburgerMenuImageItem.Thumbnail>
                        </mah:HamburgerMenuImageItem>
                    </mah:HamburgerMenuItemCollection>
                </mah:HamburgerMenu.OptionsItemsSource>
            </mah:HamburgerMenu>
        </Grid>
    </Grid>
</mah:MetroWindow>
