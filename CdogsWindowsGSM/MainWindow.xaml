<mah:MetroWindow x:Class="WindowsGSM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsGSM"
        xmlns:loc="clr-namespace:WindowsGSM.Localization"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"          
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="WindowsGSM" 
        Height="650" 
        Width="1000" 
        Icon="Images\WindowsGSM-Icon-Border.ico"
        ResizeMode="CanResizeWithGrip"
        MinHeight="650"
        MinWidth="1000"
        Closing="Window_Closing"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        WindowStartupLocation="CenterScreen" Activated="Window_Activated">
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button x:Name="button_Website" Content="{loc:Loc Key=Website}" Click="Button_Website_Click"/>
            <Button x:Name="button_Discord" Content="{loc:Loc Key=Discord}" Click="Button_Discord_Click"/>
            <!--<Button x:Name="button_Settings" Content="Settings" Click="Button_Settings_Click"/>-->
            <Button x:Name="button_Hide" Content="{loc:Loc Key=Hide}" Click="Button_Hide_Click"/>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout x:Name="MahAppFlyout_ViewPlugins" Header="{loc:Loc Key=PluginsTitle}" Position="Right" Width="600" Theme="Dark" IsModal="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Label Content="{loc:Loc Key=Installed}" Margin="12,0,0,10" FontSize="14" FontWeight="SemiBold" Padding="5,5.5,0,5"></Label>
                            <Label x:Name="Label_PluginInstalled" Content=" 0" Margin="0,0,10,10" FontSize="15" FontWeight="SemiBold" Foreground="Aqua"></Label>
                            <Label Content="{loc:Loc Key=Loaded}" Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold" Padding="5,5.5,0,5"></Label>
                            <Label x:Name="Label_PluginLoaded" Content="0" Margin="0,0,10,10" FontSize="15" FontWeight="SemiBold" Foreground="GreenYellow"></Label>
                            <Label Content="{loc:Loc Key=Failed}" Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold" Padding="5,5.5,0,5"></Label>
                            <Label x:Name="Label_PluginFailed" Content="0" Margin="0,0,10,10" FontSize="15" FontWeight="SemiBold" Foreground="Red"></Label>
                        </StackPanel>
                        <Button x:Name="Button_ImportPlugin" Content="{loc:Loc Key=ImportPlugin}" Height="29" Width="130" HorizontalAlignment="Right" Click="ImportPlugin_Click" Margin="-20,-50,150,0"></Button>
                        <Button x:Name="Button_RefreshPlugins" Content="{loc:Loc Key=ReloadPlugins}" Height="29" Width="130" HorizontalAlignment="Right" Margin="-20,-50,12,0" Click="RefreshPlugins_Click"></Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Label Content="✔️" Margin="10,0,0,10" FontSize="17" FontWeight="SemiBold" Foreground="GreenYellow"></Label>
                        <Label Content="{loc:Loc Key=LoadedPluginList}" Margin="0,0,10,10" FontSize="17" FontWeight="SemiBold"></Label>
                    </StackPanel>

                    <mah:MetroProgressBar x:Name="ProgressRing_LoadPlugins" IsIndeterminate="True" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="10,0,10,10" DockPanel.Dock="Top" Visibility="Collapsed"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StackPanel_PluginList">
                            <!--
                            <Border BorderBrush="GreenYellow" Background="SlateGray" BorderThickness="1.5" CornerRadius="5" Padding="6" Margin="10,0,10,10">
                                <DockPanel>
                                    <Border BorderBrush="White" BorderThickness="0" CornerRadius="5" Padding="10" Width="61" Height="61" Margin="0,0,10,0">
                                        <Border.Background><ImageBrush Stretch="Fill" ImageSource="Images/Games/arma3.png"></ImageBrush></Border.Background>
                                    </Border>

                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,3,0">
                                        <Label Content="v1.0" DockPanel.Dock="Right" Padding="0"></Label>
                                        <Label Content="WindowsGSM.ARMA3" DockPanel.Dock="Left" FontSize="14" FontWeight="Bold" Padding="0"></Label>
                                    </DockPanel>

                                    <TextBlock Text="WindowsGSM Plugin - Arma 3 Dedicated Server" DockPanel.Dock="Top"></TextBlock>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Border BorderBrush="DimGray" BorderThickness="0" CornerRadius="30" Padding="10" Width="25" Height="25" Margin="0,0,5,0">
                                            <Border.Background><ImageBrush Stretch="Fill" ImageSource="Images/Games/tf2.png"></ImageBrush></Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Label Content="BattlefieldDuck" DockPanel.Dock="Top" Padding="0" ></Label>
                                            <Label Content="•" DockPanel.Dock="Top" Padding="0" Margin="5,0,5,0" ></Label>
                                            <TextBlock><Hyperlink Foreground="GreenYellow">https://github.com/BattlefieldDuck</Hyperlink></TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            -->

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_Settings" Header="{loc:Loc Key=SettingsTitle}" Position="Right" Width="300" Theme="Dark" IsModal="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_HardWareAcceleration" Header="{loc:Loc Key=HardwareAcceleration}" Margin="20,10,0,15" Toggled="HardWareAcceleration_IsCheckedChanged"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_UIAnimation" Header="{loc:Loc Key=UIAnimation}" Margin="20,0,0,15" Toggled="UIAnimation_IsCheckedChanged"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_DarkTheme" Header="{loc:Loc Key=DarkTheme}" Margin="20,0,0,15" Toggled="DarkTheme_IsCheckedChanged"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_StartOnBoot" Header="{loc:Loc Key=StartWindowsGSMOnLogin}" Margin="20,0,0,15" Toggled="StartOnLogin_IsCheckedChanged"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_RestartOnCrash" Header="{loc:Loc Key=AutoRestartWindowsGSMOnCrash}" Margin="20,0,0,15" Toggled="RestartOnCrash_IsCheckedChanged"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_SendStatistics" Header="{loc:Loc Key=SendStatistics}" Margin="20,0,0,15" Toggled="SendStatistics_IsCheckedChanged"/>
                        <DockPanel Margin="20,0,20,20">
                            <Label Content="{loc:Loc Key=WindowsGSMTheme}" FontSize="13.5" Padding="0" DockPanel.Dock="Top"></Label>
                            <ComboBox x:Name="comboBox_Themes" Margin="0,5,0,0" Height="25" DockPanel.Dock="Top" SelectionChanged="ComboBox_Themes_SelectionChanged"></ComboBox>
                        </DockPanel>
                        <DockPanel Margin="20,0,20,20">
                            <Label Content="{loc:Loc Key=LanguageLabel}" FontSize="13.5" Padding="0" DockPanel.Dock="Top"/>
                            <ComboBox x:Name="comboBox_Language" Margin="0,5,0,0" Height="25" DockPanel.Dock="Top" SelectedValuePath="Tag" SelectionChanged="ComboBox_Language_SelectionChanged">
                                <ComboBoxItem Tag="system" Content="{loc:Loc Key=LanguageSystem}"/>
                                <ComboBoxItem Tag="en" Content="{loc:Loc Key=LanguageEnglish}"/>
                                <ComboBoxItem Tag="es" Content="{loc:Loc Key=LanguageSpanish}"/>
                            </ComboBox>
                            <TextBlock Text="{loc:Loc Key=LanguageRestartRequired}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_DiscordAlert" Header="{loc:Loc Key=DiscordAlertSettings}" Position="Bottom" Theme="Dark">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal">
                        <mah:ToggleSwitch x:Name="MahAppSwitch_AutoStartAlert" Header="{loc:Loc Key=AutoStartAlert}" Margin="20,20,0,20" Toggled="Switch_AutoStartAlert_Click"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_AutoRestartAlert" Header="{loc:Loc Key=AutoRestartAlert}" Margin="0,20,0,20" Toggled="Switch_AutoRestartAlert_Click"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_AutoUpdateAlert" Header="{loc:Loc Key=AutoUpdateAlert}" Margin="0,20,0,20" Toggled="Switch_AutoUpdateAlert_Click"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_RestartCrontabAlert" Header="{loc:Loc Key=RestartCrontabAlert}" Margin="0,20,0,20" Toggled="Switch_RestartCrontabAlert_Click"/>
                        <mah:ToggleSwitch x:Name="MahAppSwitch_CrashAlert" Header="{loc:Loc Key=CrashAlert}" Margin="20,20,0,20" Toggled="Switch_CrashAlert_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_RestoreBackup" Header="{loc:Loc Key=RestoreBackup}" Position="Right" Theme="Adapt" IsModal="True">
                <Grid Margin="15,0,15,15">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,35">
                        <DockPanel DockPanel.Dock="Top">
                            <Label DockPanel.Dock="Left" Content="{loc:Loc Key=ServerLabel}" Padding="5,5,0,5"/>
                            <Label x:Name="label_RestoreBackupServerName" Content="{loc:Loc Key=ServerNameLabel}"/>
                        </DockPanel>
                        <Label DockPanel.Dock="Top" Content="{loc:Loc Key=PleaseSelectBackup}"/>
                        <ListBox x:Name="listbox_RestoreBackup" DockPanel.Dock="Top" BorderThickness="1" Width="300"/>
                    </DockPanel>
                    <Button VerticalAlignment="Bottom" x:Name="button_RestoreBackup" Content="{loc:Loc Key=Restore}" Click="Button_RestoreBackup_Click"/>
                </Grid>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_SetAffinity" Header="{loc:Loc Key=SetAffinity}" Position="Bottom" Theme="Dark">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StackPanel_SetAffinity" Orientation="Horizontal" VerticalAlignment="Center" Margin="20"/>
                </ScrollViewer>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_EditConfig" Header="{loc:Loc Key=EditConfigTitle}" Position="Right" Theme="Adapt" IsModal="True">
                <Grid Margin="15,0,15,15">
                    <DockPanel Margin="0,0,0,35">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <StackPanel>
                                    <Label Content="{loc:Loc Key=ServerIdLabel}"></Label>
                                    <TextBox x:Name="textbox_EC_ServerID" Height="23" Width="120" TextWrapping="Wrap" Text="" FontFamily="Consolas" VerticalAlignment="Top" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <Label Content="{loc:Loc Key=ServerGameLabel}"></Label>
                                    <TextBox x:Name="textbox_EC_ServerGame" Height="23" Width="375" TextWrapping="Wrap" Text="" FontFamily="Consolas" VerticalAlignment="Top" IsReadOnly="True"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <Label Content="{loc:Loc Key=ServerNameLabel}"></Label>
                                <TextBox x:Name="textbox_EC_ServerName" Height="23" Width="500" TextWrapping="Wrap" Text="" FontFamily="Consolas" VerticalAlignment="Top"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <StackPanel>
                                    <Label Content="{loc:Loc Key=ServerIpAddressLabel}"></Label>
                                    <TextBox x:Name="textbox_EC_ServerIP" Height="23" Width="120" TextWrapping="Wrap" Text="" FontFamily="Consolas" VerticalAlignment="Top"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <Label Content="{loc:Loc Key=ServerPortLabel}"></Label>
                                    <mah:NumericUpDown x:Name="numericUpDown_EC_ServerPort" Minimum="1" Maximum="65535" FontFamily="Consolas" Interval="1" Height="5" Width="120"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <Label Content="{loc:Loc Key=ServerQueryPortLabel}"></Label>
                                    <mah:NumericUpDown x:Name="numericUpDown_EC_ServerQueryPort" Minimum="1" Maximum="65535" FontFamily="Consolas" Interval="1" Height="5" Width="120"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <Label Content="{loc:Loc Key=ServerMaxPlayersLabel}"></Label>
                                    <mah:NumericUpDown x:Name="numericUpDown_EC_ServerMaxplayer" Minimum="1" Maximum="100000" FontFamily="Consolas" Interval="1" Height="5" Width="120"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <Label Content="{loc:Loc Key=ServerStartMapLabel}"></Label>
                                <TextBox x:Name="textbox_EC_ServerMap" Height="23" Width="500" FontFamily="Consolas" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                            </StackPanel>
                            <StackPanel x:Name="stackPanel_EC_MapRotation" Margin="0,0,0,10" Visibility="Collapsed">
                                <Label Content="{loc:Loc Key=MapRotation}"/>
                                <TextBlock x:Name="textBlock_EC_MapRotationStatus" Margin="5,0,0,5" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="{loc:Loc Key=AvailableMaps}"/>
                                        <ListBox x:Name="listBox_EC_AvailableMaps" Height="100" FontFamily="Consolas" MouseDoubleClick="ListBox_EC_AvailableMaps_MouseDoubleClick"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                        <Button Content="{loc:Loc Key=AddMap}" Click="Button_EC_AddMap_Click" Margin="0,2"/>
                                        <Button Content="{loc:Loc Key=RemoveMap}" Click="Button_EC_RemoveMap_Click" Margin="0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="{loc:Loc Key=RotationOrder}"/>
                                        <ListBox x:Name="listBox_EC_MapRotation" Height="100" FontFamily="Consolas" MouseDoubleClick="ListBox_EC_MapRotation_MouseDoubleClick"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{loc:Loc Key=MoveUp}" Click="Button_EC_MoveMapUp_Click" Margin="2"/>
                                    <Button Content="{loc:Loc Key=MoveDown}" Click="Button_EC_MoveMapDown_Click" Margin="2"/>
                                    <Button Content="{loc:Loc Key=Randomise}" Click="Button_EC_RandomiseMapRotation_Click" Margin="2"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <Label Content="{loc:Loc Key=ServerGsltLabel}"></Label>
                                <TextBox x:Name="textbox_EC_ServerGSLT" Height="23" Width="500" FontFamily="Consolas" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                            </StackPanel>
                            <StackPanel>
                                <Label Content="{loc:Loc Key=ServerStartParamLabel}"></Label>
                            </StackPanel>
                        </StackPanel>
                        <TextBox x:Name="textbox_EC_ServerParam" Width="500" TextWrapping="Wrap" FontFamily="Consolas" Text="" DockPanel.Dock="Top"/>
                        <StackPanel x:Name="stackPanel_EC_CfxSettings" Visibility="Collapsed" Margin="0,10,0,0" DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=CfxLicenseKeyKeepCurrent}" Padding="0,5,0,2"/>
                            <PasswordBox x:Name="passwordBox_EC_CfxLicenseKey" Height="23"/>
                        </StackPanel>
                        <StackPanel x:Name="stackPanel_EC_Cod1Settings" Visibility="Collapsed" Margin="0,10,0,0" DockPanel.Dock="Top">
                            <CheckBox x:Name="checkBox_EC_Cod1MeatBots" Content="{loc:Loc Key=EnableMeatBots}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="{loc:Loc Key=AlliesBots}" Padding="0,5,5,5"/>
                                <mah:NumericUpDown x:Name="numericUpDown_EC_Cod1AlliesBots" Minimum="0" Maximum="32" Value="0" Interval="1" Width="90"/>
                                <Label Content="{loc:Loc Key=AxisBots}" Padding="10,5,5,5"/>
                                <mah:NumericUpDown x:Name="numericUpDown_EC_Cod1AxisBots" Minimum="0" Maximum="32" Value="0" Interval="1" Width="90"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Button x:Name="button_EC_SaveConfig" VerticalAlignment="Bottom" Content="{loc:Loc Key=Save}" Width="500" Height="25" Click="Button_EditConfig_Save_Click"/>
                </Grid>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_ManageAddons" Header="{loc:Loc Key=ManageAddons}" Position="Right" Theme="Adapt" IsModal="True">
                <DockPanel VerticalAlignment="Stretch" Height="Auto">
                    <DockPanel Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=NameLabel}" FontFamily="Consolas"></Label>
                            <Label x:Name="label_ManageAddonsName" FontFamily="Consolas"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=GameLabel}" FontFamily="Consolas"></Label>
                            <Label x:Name="label_ManageAddonsGame" FontFamily="Consolas"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=TypeLabel}" FontFamily="Consolas"></Label>
                            <Label x:Name="label_ManageAddonsType" FontFamily="Consolas"></Label>
                        </StackPanel>
                        <DockPanel Margin="0,5,0,0">
                            <DockPanel>
                                <Label Content="{loc:Loc Key=DisabledAddonHint}" DockPanel.Dock="Top"></Label>
                                <ListBox x:Name="listBox_ManageAddonsLeft" Margin="0,0,0,20" BorderThickness="1" DockPanel.Dock="Top" Width="300" MinHeight="300" MouseDoubleClick="ListBox_ManageAddonsLeft_DoubleClick"/>
                            </DockPanel>
                            <DockPanel Margin="10,0,20,0">
                                <Label Content="{loc:Loc Key=EnabledAddonHint}" DockPanel.Dock="Top"></Label>
                                <ListBox x:Name="listBox_ManageAddonsRight" Margin="0,0,0,20" BorderThickness="1" DockPanel.Dock="Top" Width="300" MinHeight="300" MouseDoubleClick="ListBox_ManageAddonsRight_DoubleClick"/>
                            </DockPanel>
                        </DockPanel>
                    </DockPanel>
                </DockPanel>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_InstallGameServer" Header="{loc:Loc Key=InstallGameServer}" Width="500" Position="Left" Theme="Adapt" IsModal="True">
                <DockPanel VerticalAlignment="Stretch" Height="Auto">
                    <DockPanel Margin="20,0,20,0">
                        <DockPanel DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=GameServerLabel}"></Label>
                            <Label x:Name="label_GameServerCount" Content="" HorizontalAlignment="Right"></Label>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,15" DockPanel.Dock="Top" MinWidth="350">
                            <ComboBox x:Name="comboBox_InstallGameServer" VerticalAlignment="Top" SelectionChanged="ComboBox_InstallGameServer_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <Label Content="{loc:Loc Key=ServerNameLabel}" DockPanel.Dock="Top"></Label>
                        <DockPanel Margin="0,0,0,15" DockPanel.Dock="Top">
                            <TextBox x:Name="textbox_InstallServerName" Height="23" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                        </DockPanel>

                        <StackPanel x:Name="stackPanel_Install_CfxSettings" Visibility="Collapsed" Margin="0,0,0,15" DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=CfxLicenseKeyFromPortal}" Padding="0,5,0,2"/>
                            <PasswordBox x:Name="passwordBox_Install_CfxLicenseKey" Height="23"/>
                        </StackPanel>

                        <StackPanel x:Name="stackPanel_Install_Cod1Settings" Visibility="Collapsed" Margin="0,0,0,15" DockPanel.Dock="Top">
                            <CheckBox x:Name="checkBox_Install_Cod1MeatBots" Content="{loc:Loc Key=InstallMeatBots}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="{loc:Loc Key=AlliesBots}" Padding="0,5,5,5"/>
                                <mah:NumericUpDown x:Name="numericUpDown_Install_Cod1AlliesBots" Minimum="0" Maximum="32" Value="0" Interval="1" Width="90"/>
                                <Label Content="{loc:Loc Key=AxisBots}" Padding="10,5,5,5"/>
                                <mah:NumericUpDown x:Name="numericUpDown_Install_Cod1AxisBots" Minimum="0" Maximum="32" Value="0" Interval="1" Width="90"/>
                            </StackPanel>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,15" DockPanel.Dock="Top">
                            <Button x:Name="button_InstallSetAccount" Content="{loc:Loc Key=SetAccount}" DockPanel.Dock="Left" Width="120" Margin="0,0,5,0" Click="Button_SetAccount_Click"/>
                            <Button x:Name="button_Install" Content="{loc:Loc Key=Install}" VerticalAlignment="Top" Click="Button_Install_Click"/>
                        </DockPanel>

                        <Label Content="{loc:Loc Key=Progress}" DockPanel.Dock="Top"></Label>
                        <DockPanel Margin="0,0,0,15" DockPanel.Dock="Top">
                            <Grid Height="23" VerticalAlignment="Top">
                                <ProgressBar x:Name="progressbar_InstallProgress" Value="0"/>
                                <TextBlock x:Name="textblock_InstallProgress" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,5" DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=InstallLog}" DockPanel.Dock="Left"></Label>
                            <DockPanel HorizontalAlignment="Right">
                                <TextBox x:Name="textBox_InstallToken" Height="23" TextWrapping="Wrap" DockPanel.Dock="Left" MaxLines="1" Margin="5,0,5,0" Width="100"/>
                                <Button x:Name="button_InstallSendToken" Content="{loc:Loc Key=SendToken}" DockPanel.Dock="Right" Width="100" Click="Button_SendToken_Click"/>
                            </DockPanel>
                        </DockPanel>
                        <TextBox x:Name="textbox_InstallLog" Margin="0,0,0,20" DockPanel.Dock="Top" TextWrapping="Wrap" IsReadOnly="true"/>
                    </DockPanel>
                </DockPanel>
            </mah:Flyout>
            <mah:Flyout x:Name="MahAppFlyout_ImportGameServer" Header="{loc:Loc Key=ImportGameServer}" Width="500" Position="Left" Theme="Adapt" IsModal="True">
                <DockPanel VerticalAlignment="Stretch" Height="Auto">
                    <DockPanel Margin="20,0,20,0">

                        <DockPanel DockPanel.Dock="Top">
                            <Label Content="{loc:Loc Key=GameServerLabel}"></Label>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,15" DockPanel.Dock="Top" MinWidth="350">
                            <ComboBox x:Name="comboBox_ImportGameServer" VerticalAlignment="Top">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Image}" Width="16" Height="16"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <Label Content="{loc:Loc Key=ServerNameLabel}" DockPanel.Dock="Top"></Label>
                        <DockPanel Margin="0,0,0,15" DockPanel.Dock="Top">
                            <TextBox x:Name="textbox_ImportServerName" Height="23" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                        </DockPanel>

                        <Label Content="{loc:Loc Key=OldServerDirectory}" DockPanel.Dock="Top"/>
                        <DockPanel Margin="0,0,0,0" DockPanel.Dock="Top">
                            <TextBox x:Name="textbox_ServerDir" Height="23" TextWrapping="Wrap" Text="" DockPanel.Dock="Left" Width="280"/>
                            <Button x:Name="button_Browse" Content="{loc:Loc Key=Browse}" Height="26" Width="70" Click="Button_Browse_Click"/>
                        </DockPanel>
                        <Label x:Name="label_ServerDirWarn" Content="" DockPanel.Dock="Top"/>

                        <DockPanel Margin="0,15,0,15" DockPanel.Dock="Top">
                            <Button x:Name="button_Import" Content="{loc:Loc Key=Import}" VerticalAlignment="Top" Click="Button_Import_Click"/>
