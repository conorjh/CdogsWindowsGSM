<Window x:Class="WindowsGSM.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WindowsGSM.Localization"
        Title="{loc:Loc Key=StartupStatusName}"
        Width="360"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0"
               Source="pack://application:,,,/CdogsWindowsGSM;component/Images/SplashScreen.png"
               Width="270"
               Height="270"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               AutomationProperties.Name="{loc:Loc Key=StartupLogoDescription}"/>
        <TextBlock x:Name="StartupStatusText"
                   Grid.Row="1"
                   Text="{loc:Loc Key=StartupInitializing}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   MinHeight="42"
                   Margin="4,8,4,2"
                   Foreground="White"
                   FontSize="14"
                   AutomationProperties.Name="{loc:Loc Key=StartupStatusName}"
                   AutomationProperties.HelpText="{loc:Loc Key=StartupInitializing}"
                   AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
