<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<AssemblyName>CdogsWindowsGSM-Updater</AssemblyName>
	<Version>2.0.0-preview.7</Version>
	<AssemblyVersion>2.0.0.0</AssemblyVersion>
	<FileVersion>2.0.0.0</FileVersion>
	<InformationalVersion>2.0.0-preview.7</InformationalVersion>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	<RootNamespace>CdogsWindowsGSM.Updater</RootNamespace>
	<LangVersion>7.3</LangVersion>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<SelfContained>true</SelfContained>
	<PublishSingleFile>true</PublishSingleFile>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	<DebugType>none</DebugType>
  </PropertyGroup>
  <Target Name="PublishSingleFileAfterBuild"
		  AfterTargets="Build"
		  Condition="'$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true' and '$(AutoPublishAfterBuild)' != 'false'">
	<MSBuild Projects="$(MSBuildProjectFullPath)"
			 Targets="Publish"
			 BuildInParallel="false"
			 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;AutoPublishAfterBuild=false;PublishDir=$(MSBuildProjectDirectory)\..\artifacts\updater\" />
  </Target>
</Project>
